# Shared settings for `npm run dev` (committed so the whole team gets them).
# The recommendations come from the FastAPI backend: start it first from the repository root, e.g.
#   MOODIFY_ENCODER=tfidf python -m uvicorn backend.main:app --port 8000
# To use the offline demo data instead, create frontend/.env.local with NEXT_PUBLIC_USE_MOCKS=true
# (.env.local overrides this file and is not committed).
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_URL=http://localhost:8000
